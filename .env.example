ENVIRONMENT=dev
DEBUG=true
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8001

# Ollama (must be running on host; install: https://ollama.com/download)
# Pull the default VLM before first request: `ollama pull qwen3-vl:4b-instruct`
# Alt VLM (rollback): `ollama pull minicpm-v:8b`, then set
# DEFAULT_PROVIDER=minicpm-v-2.6 (or pass per-request `provider`) to A/B test.
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_PROVIDER=qwen3-vl-4b
INFERENCE_TIMEOUT_SEC=30
RETRY_ON_PARSE_ERROR=2
# VLM context window sent to Ollama. Ollama otherwise defaults to Qwen3-VL's
# trained max (262144) — on an 8 GB GPU that overflows VRAM and the model falls
# back to CPU (verify minutes-slow). 8192 keeps it 100% on the GPU. 0 = Ollama default.
VLM_NUM_CTX=8192

# vLLM scale-path provider (DEFAULT_PROVIDER=qwen3-vl-vllm). For a dedicated
# Linux GPU host running `vllm serve Qwen/Qwen3-VL-4B-Instruct` — NOT this laptop
# node. Context/VRAM fit is set server-side via --max-model-len.
# VLLM_BASE_URL=http://your-gpu-vps:8000/v1
# VLLM_MODEL=Qwen/Qwen3-VL-4B-Instruct

FRAMES_PER_CLIP=5
FRAME_MAX_DIM=640
FRAME_JPEG_QUALITY=85

# Talking back to sentry-backend (OUTBOUND token sentry-ai SENDS to the backend).
SENTRY_BACKEND_URL=http://localhost:8000
SENTRY_BACKEND_SERVICE_TOKEN=replace-with-token-from-backend-startup-log

# INBOUND service token the backend must send to /v1/* (Bearer). Empty = OPEN
# (trusted-LAN default). ⚠️ MUST be set on any internet-reachable node — esp. an
# edge-verdict node serving /v1/edge-clip-upload — or the routes run auth-open.
# Set the SAME value as the backend's SENTRY_AI_SERVICE_TOKEN.
AI_SERVICE_TOKEN=
# Dir uploaded/cut clips are confined to (path-traversal guard). /v1/edge-clip-upload
# streams the agent's bytes into a temp file here; /v1/verify confines clip_path here.
CLIP_STORAGE_ROOT=

# --- Live worker (per-camera YOLO + behaviour engine) ---
LIVE_FRAME_SKIP=3
# YOLO26 (ADR-0026): NMS-free, better occluded keypoints. Roll back with
# yolo11s-pose.pt / yolo11n.pt if a regression shows up on the node.
YOLO_POSE_WEIGHTS=yolo26s-pose.pt
YOLO_ITEM_WEIGHTS=yolo26n.pt

# Cross-camera re-identification (links one shopper across the store's cameras so
# suspicion accumulates). "histogram" = dependency-light HSV histogram (default,
# weak — confuses similar clothing). "osnet" = learned torchreid model (robust;
# RECOMMENDED on the GPU node). For osnet, install torchreid manually on the node
# (`uv pip install "torchreid @ git+https://github.com/KaiyangZhou/deep-person-reid.git"`);
# it falls back to histogram automatically if torchreid/torch isn't available.
REID_MODEL=histogram
